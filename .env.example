# SpookyBeats — Variables d'environnement (exemple)
# Créer un fichier .env.local avec vos vraies valeurs.
# Ce fichier .env.example est versionné (sans secrets).

# URL de l'application hébergée (utilisée pour les liens canoniques SEO)
# Exemple : https://games.hylst.fr/spookybeats
APP_URL="https://games.hylst.fr/spookybeats"

# URL racine de l'hébergement audio Hylst (ne pas modifier sauf migration)
HYLST_AUDIO_BASE="https://hylst.fr/hml"
HYLST_SFX_BASE="https://hylst.fr/mp3/sfx"
